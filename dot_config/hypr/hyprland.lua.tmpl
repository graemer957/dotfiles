-- See https://wiki.hypr.land/Configuring/Basics/Binds/
local mainMod = "SUPER" -- Sets "Windows" key as main modifier

hl.bind(mainMod .. " + A", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + W", hl.dsp.window.close())
hl.bind(mainMod .. " + CTRL + SHIFT + M", hl.dsp.exit())
hl.bind(mainMod .. " + R", hl.dsp.exec_cmd(menu))
hl.bind(mainMod .. " + equal", hl.dsp.exec_cmd([[rofi -show calc -modi calc -no-show-match -no-sort -calc-command "echo '{result}' | wl-copy"]]))
hl.bind(mainMod .. " + L", hl.dsp.exec_cmd("~/.local/bin/lock"))
hl.bind(mainMod .. " + CTRL + SHIFT + S", hl.dsp.exec_cmd("~/.local/bin/lock & sleep 5 && systemctl suspend"))
-- pause/resume break timer
hl.bind(mainMod .. " + B", hl.dsp.exec_cmd("pkill --signal USR1 -f 'bin/break_timer'"))
hl.bind(mainMod .. " + SHIFT + V", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + SHIFT + P", hl.dsp.window.pseudo()) -- dwindle
hl.bind(mainMod .. " + comma", hl.dsp.layout("togglesplit")) -- dwindle
hl.bind(mainMod .. " + period", hl.dsp.exec_cmd("rofi -modi emoji -show emoji"))
hl.bind(mainMod .. " + F", hl.dsp.window.fullscreen())
hl.bind(mainMod .. " + SHIFT + A", hl.dsp.exec_cmd(browser .. " & " .. terminal))

-- Screenshots
hl.bind("Print", hl.dsp.exec_cmd("grim"))
hl.bind("SHIFT + Print", hl.dsp.exec_cmd([[grim -g "$(slurp)"]]))

-- Handy audio control
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("pactl set-sink-mute @DEFAULT_SINK@ false ; pactl set-sink-volume @DEFAULT_SINK@ -3%"))
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("pactl set-sink-mute @DEFAULT_SINK@ false ; pactl set-sink-volume @DEFAULT_SINK@ +3%"))
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("pactl set-sink-mute @DEFAULT_SINK@ toggle"))
hl.bind(mainMod .. " + P", hl.dsp.exec_cmd("playerctl play-pause"))
hl.bind(mainMod .. " + I", hl.dsp.exec_cmd("playerctl next"))
hl.bind(mainMod .. " + U", hl.dsp.exec_cmd("playerctl previous"))

local btHeadset = "AC:80:0A:7B:00:87"
hl.bind(mainMod .. " + XF86AudioMute", hl.dsp.exec_cmd("bluetoothctl connect " .. btHeadset))
hl.bind(mainMod .. " + SHIFT + XF86AudioMute", hl.dsp.exec_cmd("bluetoothctl disconnect " .. btHeadset))

-- Move focus with alt + vim arrow keys
hl.bind("ALT + h", hl.dsp.focus({ direction = "left" }))
hl.bind("ALT + SHIFT + h", hl.dsp.window.resize({ x = -32, y = 0, relative = true }))
hl.bind("ALT + l", hl.dsp.focus({ direction = "right" }))
hl.bind("ALT + SHIFT + l", hl.dsp.window.resize({ x = 32, y = 0, relative = true }))
hl.bind("ALT + k", hl.dsp.focus({ direction = "up" }))
hl.bind("ALT + SHIFT + k", hl.dsp.window.resize({ x = 0, y = -32, relative = true }))
hl.bind("ALT + j", hl.dsp.focus({ direction = "down" }))
hl.bind("ALT + SHIFT + j", hl.dsp.window.resize({ x = 0, y = 32, relative = true }))

-- Percentage resizes: the Lua resize dispatcher takes pixels only, so resolve
-- the monitor-relative width at dispatch time.
local function resizeExactPct(pctW, pctH)
    return function()
        local m = hl.get_active_monitor()
        if not m then return end
        hl.dispatch(hl.dsp.window.resize({
            x = math.floor(m.width * pctW / 100),
            y = math.floor(m.height * pctH / 100),
        }))
    end
end

hl.bind("ALT + SHIFT + bracketleft",  resizeExactPct(33, 100)) -- left 1/3, right 2/3
hl.bind("ALT + SHIFT + bracketright", resizeExactPct(67, 100)) -- left 2/3, right 1/3
hl.bind("ALT + SHIFT + equal",        resizeExactPct(50, 100)) -- reset to 50/50

-- Switch workspaces with mainMod + [0-9]
-- Move active window to a workspace with mainMod + SHIFT + [0-9]
for i = 1, 10 do
    local key = i % 10 -- 10 maps to key 0
    hl.bind(mainMod .. " + " .. key, hl.dsp.focus({ workspace = i }))
    hl.bind(mainMod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }))
end

-- Special workspace (scratchpad)
hl.bind(mainMod .. " + S", hl.dsp.workspace.toggle_special("magic"))
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.window.move({ workspace = "special:magic" }))

-- Scroll through workspaces with mainMod + scroll or j/k
hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "r+1" }))
hl.bind(mainMod .. " + mouse_up", hl.dsp.focus({ workspace = "r-1" }))
hl.bind(mainMod .. " + J", hl.dsp.focus({ workspace = "r+1" }))
hl.bind(mainMod .. " + K", hl.dsp.focus({ workspace = "r-1" }))
hl.bind(mainMod .. " + SHIFT + J", hl.dsp.window.move({ workspace = "r+1" }))
hl.bind(mainMod .. " + SHIFT + K", hl.dsp.window.move({ workspace = "r-1" }))

-- Move/resize windows with mainMod + LMB/RMB and dragging
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(), { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })



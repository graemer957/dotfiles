-------------------
---- AUTOSTART ----
-------------------

-- Autostart necessary processes (like notifications daemons, status bars, etc.)
-- Or execute your favorite apps at launch like this:

hl.on("hyprland.start", function()
    hl.exec_cmd("yambar")
    hl.exec_cmd(browser)
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
    hl.exec_cmd("/usr/lib/mate-polkit/polkit-mate-authentication-agent-1")
    hl.exec_cmd("alacritty", { workspace = "2 silent" })
    hl.exec_cmd("1password", { workspace = "special:magic silent" })
    hl.exec_cmd("signal-desktop", { workspace = "special:magic silent" })
    hl.exec_cmd("alacritty", { workspace = "special:magic silent" })

    -- Colour scheme - modern apps read this via `xdg-desktop-portal`
    hl.exec_cmd("gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'")
    hl.exec_cmd("gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'")
end)



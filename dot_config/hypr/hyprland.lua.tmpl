-- See https://wiki.hypr.land/Configuring/Basics/Window-Rules/
-- and https://wiki.hypr.land/Configuring/Basics/Workspace-Rules/

hl.window_rule({
    name  = "windowrule-1",
    match = { class = "^(Rofi)$" },
    float = true,
})

hl.window_rule({
    name  = "windowrule-2",
    match = { class = ".*" }, -- You'll probably like this.
    suppress_event = "maximize",
})

hl.window_rule({
    name  = "windowrule-3",
    match = { class = "^(Signal)$" },
    workspace = "special:magic",
})

hl.window_rule({
    name  = "windowrule-4",
    match = { class = "^(1Password)$", float = false },
    workspace = "special:magic",
})

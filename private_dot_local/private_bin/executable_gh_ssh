#!/usr/bin/env bash

# Generated by 🤖 Claude Opus 5
# v0.2

# gh_ssh — GIT_SSH_COMMAND: loads this host's GitHub-only key from 1Password
# into the session agent on first use, then hands over to ssh.
#
# The .pub is the only per-host state: the public key, with the 1Password
# item's op:// reference as its comment. A missing .pub, or one without a
# valid reference, sends the call through onboarding, which rebuilds it from
# the item named claude-<host>.
set -o pipefail

KEY_LIFETIME=15m
OP_TIMEOUT=90   # < Claude's 120s Bash-tool kill, so the failure reason gets out
LOG="$HOME/.local/state/gh_ssh/log"   # one line per onboarding, key load or failure
# shellcheck disable=SC2016  # literal backticks: this is the note's Markdown
NOTE='GitHub only - never in `authorized_keys`'

name="claude-${HOSTNAME%%.*}"   # short hostname, as chezmoi's .chezmoi.hostname
pub="$HOME/.ssh/$name.pub"
ref_re='^op://[a-z0-9]{26}/[a-z0-9]{26}$'   # op://<vault-uuid>/<item-uuid>

log() { local ts; ts=$(date -Is); mkdir -p "${LOG%/*}" && printf '%s %s\n' "$ts" "$*" >>"$LOG"; }
# die <reason> [help line…]: the reason is logged; every line goes to stderr.
die() { log "FAIL $1 | ${ctx-}"; echo "gh_ssh: $1" >&2; shift; (( $# )) && printf '  %s\n' "$@" >&2; exit 1; }
op_timed_out() {
    die "1Password approval timed out (${OP_TIMEOUT}s) — Graeme may be AFK." \
        "Carry on with anything that doesn't need GitHub, ask him to say when he's back, then retry."
}

[[ -S ${SSH_AUTH_SOCK-} ]] || die "no session agent — launch via the 'claude' fish wrapper"

ctx="session=${CLAUDE_CODE_SESSION_ID:-none} git_pid=$PPID cwd=$PWD | ${*: -1}"

# Sets ref and writes $pub from the 1Password item, whose own error (if any)
# reaches stderr above ours.
onboard() {
    command -v jq >/dev/null || die "onboarding needs jq, which isn't installed"
    local json key notes type blob
    json=$(timeout "$OP_TIMEOUT" op item get "$name" --format json)
    case $? in
        0)   ;;
        124) op_timed_out ;;
        *)   die "1Password lookup of '$name' failed (op's reason above)." \
                 "If the item doesn't exist yet, Graeme sets this host up:" \
                 "1. 1Password → new SSH Key item '$name', note: $NOTE" \
                 "2. GitHub → Settings → SSH and GPG keys → New SSH key, type Authentication," \
                 "   title '$name', paste the item's public key" \
                 "3. Retry: the next git call finishes onboarding (OP_ACCOUNT must name the item's account)" ;;
    esac
    ref=$(jq -r '"op://\(.vault.id)/\(.id)"' <<<"$json")
    key=$(jq -r '.fields[] | select(.id == "public_key") | .value' <<<"$json")
    notes=$(jq -r '[.fields[] | select(.purpose == "NOTES") | .value][0] // ""' <<<"$json")
    [[ $ref =~ $ref_re && $key == ssh-* ]] \
        || die "'$name' isn't an SSH Key item (ref '$ref', public key '${key:0:20}…')"

    read -r type blob _ <<<"$key"   # drop any comment: ours replaces it
    if ! { printf '%s %s %s\n' "$type" "$blob" "$ref" >"$pub.tmp" && mv "$pub.tmp" "$pub"; }; then
        die "couldn't write $pub"
    fi
    log "onboarded $name as $ref | $ctx"
    [[ $notes == "$NOTE" ]] \
        || echo "gh_ssh: warning: '$name' note reads '$notes'; expected '$NOTE'" >&2
}

ref=
[[ -r $pub ]] && read -r _ _ ref <"$pub"
[[ $ref =~ $ref_re ]] || onboard

fp=$(ssh-keygen -lf "$pub" | awk '{print $2}')
if ! ssh-add -l 2>/dev/null | grep -qF "$fp"; then
    timeout "$OP_TIMEOUT" op read "$ref/private key" | ssh-add -q -t "$KEY_LIFETIME" -
    rc=("${PIPESTATUS[@]}")
    case ${rc[0]} in
        0)   ;;
        124) op_timed_out ;;
        *)   die "op read failed (rc=${rc[0]}) — 1Password locked/not signed in, or the item is gone." \
                 "If '$name' was deleted or replaced, delete $pub: the next call re-onboards." ;;
    esac
    (( rc[1] == 0 )) || die "ssh-add failed (rc=${rc[1]}) — session agent not accepting keys?"
    if ! ssh-add -l 2>/dev/null | grep -qF "$fp"; then
        ssh-add -q -D   # the session agent holds only this key
        die "the key in 1Password no longer matches $pub." \
            "Regenerated in 1Password? Delete $pub (the next call re-onboards)" \
            "and replace the key on GitHub."
    fi
    log "loaded for $KEY_LIFETIME | $ctx"
fi

# Not a no-op: an IdentityAgent in ssh_config would otherwise beat SSH_AUTH_SOCK.
exec ssh -o IdentityAgent=SSH_AUTH_SOCK -o IdentitiesOnly=yes -i "$pub" "$@"

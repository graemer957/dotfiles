#!/usr/bin/env bash

# Generated by 🤖 Claude Opus 5
# v0.1

# gh_ssh — GIT_SSH_COMMAND: loads the per-host key from 1Password into the
# session agent on first use, then hands over to ssh.
set -o pipefail

KEY_LIFETIME=15m
OP_TIMEOUT=90   # < Claude's 120s Bash-tool kill, so the failure reason gets out
LOG="$HOME/.local/state/gh_ssh/log"   # one line per key load or failure

{{ if eq .chezmoi.hostname "trinity" -}}
item='op://jfabgjw6euv4xxc2e2oqqlbud4/4g6kyunpxkhaplymmz4ra43tka'
{{- else -}}
item=''
{{- end }}
pub="$HOME/.ssh/claude-{{ .chezmoi.hostname }}.pub"

log() { mkdir -p "${LOG%/*}" && printf '%s %s\n' "$(date -Is)" "$*" >>"$LOG"; }
die() { log "FAIL $* | ${ctx-}"; echo "gh_ssh: $*" >&2; exit 1; }

[[ -n $item ]]             || die "no 1Password item configured for this host"
[[ -S ${SSH_AUTH_SOCK-} ]] || die "no session agent — launch with 'claude --gh-key'"
[[ -r $pub ]]              || die "missing $pub (public half of the 1Password item)"

ctx="session=${CLAUDE_CODE_SESSION_ID:-none} git_pid=$PPID cwd=$PWD | ${*: -1}"
fp=$(ssh-keygen -lf "$pub" | awk '{print $2}')
if ! ssh-add -l 2>/dev/null | grep -qF "$fp"; then
    timeout "$OP_TIMEOUT" op read "$item/private key" | ssh-add -q -t "$KEY_LIFETIME" -
    rc=("${PIPESTATUS[@]}")
    case ${rc[0]} in
        0)   ;;
        124) die "1Password approval timed out (${OP_TIMEOUT}s) — Graeme may be AFK." \
                 "Carry on with anything that doesn't need GitHub, ask him to say when he's back, then retry." ;;
        *)   die "op read failed (rc=${rc[0]}) — 1Password locked/not signed in, or the item is missing." ;;
    esac
    (( rc[1] == 0 )) || die "ssh-add failed (rc=${rc[1]}) — session agent not accepting keys?"
    log "loaded for $KEY_LIFETIME | $ctx"
fi

# Not a no-op: an IdentityAgent in ssh_config would otherwise beat SSH_AUTH_SOCK.
exec ssh -o IdentityAgent=SSH_AUTH_SOCK -o IdentitiesOnly=yes -i "$pub" "$@"

{{- /* usage: {{ template "onepassword_field" (list $item "Label") }}
     Value of $item's top-level field with that label (exact case), where $item
     came from the `onepassword` function. Fails the render if no such field. */ -}}
{{- $item := index . 0 }}{{ $label := index . 1 }}{{ $found := false -}}
{{- range $item.fields }}{{ if eq .label $label }}{{ .value }}{{ $found = true }}{{ end }}{{ end -}}
{{- if not $found }}{{ fail (printf "onepassword_field: item %q has no field labelled %q" $item.title $label) }}{{ end -}}

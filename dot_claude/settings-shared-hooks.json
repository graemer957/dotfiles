{
  "//": "HOOKS ONLY. This file loads via --settings (claude.fish), which OUTRANKS user/project/local settings for scalar keys — any other setting added here silently pins that value across every profile. List keys (hooks) merge additively, which is the point.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/graemer/.claude/hooks/gh-branch-rename-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/graemer/.claude/hooks/bcp-instruction-gate.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/graemer/.claude/hooks/bcp-proposal-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "/home/graemer/.claude/hooks/bcp-mark.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/graemer/.claude/hooks/inject-rules.py",
            "timeout": 10,
            "statusMessage": "Checking path-scoped rules"
          },
          {
            "type": "command",
            "command": "/home/graemer/.claude/hooks/ruff-python-check.py"
          },
          {
            "type": "command",
            "command": "/home/graemer/.claude/hooks/rumdl-markdown-check.py"
          },
          {
            "type": "command",
            "command": "/home/graemer/.claude/hooks/hook-homes-check.py"
          },
          {
            "type": "command",
            "command": "/home/graemer/.claude/hooks/shellcheck-shell-check.py"
          }
        ]
      }
    ]
  }
}
